{
  "id": "claude-code",
  "name": "Claude Code",
  "description": "Hooks in ~/.claude/settings.json: shows each session (by project), peeks when it needs a permission or an answer, and when it finishes.",
  "verified": true,
  "docs": "https://code.claude.com/docs/en/hooks",
  "detect": ["%USERPROFILE%\\.claude"],
  "install": {
    "kind": "json-hooks",
    "files": ["%USERPROFILE%\\.claude\\settings.json"],
    "create_if_missing": true,
    "command": "{{blinkctl}} hook claude",
    "events": {
      "SessionStart": null,
      "UserPromptSubmit": null,
      "PostToolUse": null,
      "Notification": null,
      "PermissionRequest": null,
      "Stop": null,
      "StopFailure": null,
      "SessionEnd": null
    }
  }
}
