{
  "id": "gemini-cli",
  "name": "Gemini CLI",
  "description": "Hooks in ~/.gemini/settings.json: running, finished and needs-your-attention for each session.",
  "verified": true,
  "docs": "https://geminicli.com/docs/hooks/",
  "detect": ["%USERPROFILE%\\.gemini"],
  "install": {
    "kind": "json-hooks",
    "files": ["%USERPROFILE%\\.gemini\\settings.json"],
    "create_if_missing": true,
    "command": "{{blinkctl}} hook gemini",
    "handler": { "name": "Blink" },
    "events": {
      "SessionStart": null,
      "BeforeAgent": null,
      "AfterAgent": null,
      "Notification": null,
      "SessionEnd": null
    }
  }
}
