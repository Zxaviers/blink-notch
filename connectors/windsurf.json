{
  "id": "windsurf",
  "name": "Windsurf",
  "description": "Adds the Blink MCP server to Windsurf's global MCP config, so Cascade can report what it is doing.",
  "verified": false,
  "docs": "https://docs.windsurf.com",
  "detect": ["%USERPROFILE%\\.codeium\\windsurf"],
  "install": {
    "kind": "json-mcp",
    "files": ["%USERPROFILE%\\.codeium\\windsurf\\mcp_config.json"],
    "servers_key": "mcpServers",
    "server_name": "blink",
    "args": ["mcp"]
  }
}
